# --- LLM ---
ANTHROPIC_API_KEY=
# Default model; override to claude-sonnet-5 / claude-haiku-4-5 for cheaper runs
MODEL=claude-opus-5

# --- Jira: Scribe (Agent A) — primary surface ---
# Site URL, the account the agent posts as, and an API token from
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DOC
# Issues carrying this label are doc requests (the agent ignores everything else)
# JIRA_LABEL=doc-request
# Issue type used when Curator opens a doc request from a knowledge gap
# JIRA_ISSUE_TYPE=Task
# Moving an issue into this status publishes the draft (an `approve` comment does the same)
# JIRA_APPROVED_STATUS=Approved
# JIRA_POLL_MS=15000
# Full override of the poller's query
# JIRA_JQL=project = "DOC" AND labels = "doc-request" AND statusCategory != Done ORDER BY updated ASC

# --- Slack: Curator (Agent B) ---
# Create the app from slack-manifests/curator.yaml, then:
#   Bot token:  OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
#   App token:  Basic Information -> App-Level Tokens -> connections:write (xapp-...)
CURATOR_SLACK_BOT_TOKEN=
CURATOR_SLACK_APP_TOKEN=

# --- Slack: Scribe (Agent A) — optional secondary surface, Jira is primary ---
SCRIBE_SLACK_BOT_TOKEN=
SCRIBE_SLACK_APP_TOKEN=

# --- Paths (defaults are fine) ---
# VAULT_DIR=vault
# AUDIT_FILE=audit/log.jsonl
# STATE_DIR=.scriptorium-state
