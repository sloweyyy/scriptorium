# scriptorium — copy to `.env` and fill in. Nothing here is required to run the evals
# (`pnpm eval`); the Jira and Slack blocks are what turn on each agent's surface.

# ============================================================================
# LLM — pick ONE provider
# ============================================================================
# Which transport to use. Omit and it is inferred: ANTHROPIC_API_KEY -> anthropic,
# else VERTEX_PROJECT_ID -> vertex. Set it explicitly to choose Gemini, which shares
# the same Vertex project and needs no API key.
#   anthropic | vertex | gemini
# LLM_PROVIDER=gemini

# (a) First-party Anthropic API
ANTHROPIC_API_KEY=

# (b) Claude or Gemini on Google Vertex AI — no API key; auth is GCP ADC or a
#     service-account key. Claude additionally requires the Anthropic models to be
#     enabled in Vertex Model Garden AND online-prediction quota for the base model:
#     a fresh project starts at zero and the increase is requested per base model.
# VERTEX_PROJECT_ID=
# VERTEX_REGION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Claude model, used by the anthropic and vertex providers.
MODEL=claude-opus-5
# Gemini model, used only by LLM_PROVIDER=gemini.
# GEMINI_MODEL=gemini-3.5-flash

# ============================================================================
# Jira — Scribe (Agent A), the primary surface
# ============================================================================
# Site URL, the account the agent posts as, and an API token from
# https://id.atlassian.com/manage-profile/security/api-tokens
# Use a dedicated service account, not your own: the agent must be able to tell its
# own comments from a human's, and a shared identity makes that impossible.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DOC

# Issues carrying this label are doc requests and get drafted unasked. Everything
# else in the project is mention-only: the agent watches but never speaks first.
# JIRA_LABEL=doc-request
# Issue type used when Curator opens a doc request from a knowledge gap.
# JIRA_ISSUE_TYPE=Task

# The board columns the agent drives. Each move is best-effort — a workflow without
# a column still gets its draft, in a comment. Moving an issue INTO the approved
# status publishes the draft; an `approve` comment does the same thing.
# JIRA_IN_PROGRESS_STATUS=In Progress
# JIRA_IN_REVIEW_STATUS=In Review
# JIRA_APPROVED_STATUS=Approved
# Jira account ids whose `approve` (comment or board move) publishes. Empty: any human, never the agent.
# Set it: a project's commenters are not its approvers.
# JIRA_APPROVERS=

# JIRA_POLL_MS=15000
# Full override of the poller's query. The default widens to the whole project so
# mention-only tickets are visible, and re-includes the approved status explicitly —
# a bare `statusCategory != Done` drops the issue at the moment of approval.
# JIRA_JQL=project = "DOC" AND (statusCategory != Done OR status = "Done") ORDER BY updated ASC

# ============================================================================
# Slack — Curator (Agent B)
# ============================================================================
# Create the app from slack-manifests/curator.yaml, then:
#   Bot token:  OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
#   App token:  Basic Information -> App-Level Tokens -> connections:write (xapp-...)
CURATOR_SLACK_BOT_TOKEN=
CURATOR_SLACK_APP_TOKEN=

# --- Slack: Scribe (Agent A) — optional secondary surface, Jira is primary ---
SCRIBE_SLACK_BOT_TOKEN=
SCRIBE_SLACK_APP_TOKEN=
# Slack user ids (comma-separated) allowed to press "Approve & publish". Empty: Slack approval is off
# and approvals happen by commenting `approve` on the ticket.
SCRIBE_SLACK_APPROVERS=

# Channel for publish announcements (Curator) and draft-approval buttons (Scribe).
# `/invite` the bot to it first — its manifest has no channels:manage, so it cannot
# add itself, and a post to a channel it is not in fails with `not_in_channel`.
# Channel id (C…) or name both work. Optional: announcements are skipped without it.
# SLACK_NOTIFY_CHANNEL=C0123456789

# ============================================================================
# Docs repo — the egress. Approved docs leave the vault for a real site.
# ============================================================================
# Two branches, each owning one content tree and one site build:
#   DOCS_REPO_BRANCH          `docs/`     public site, reached only by a human merge
#   DOCS_REPO_INTERNAL_BRANCH `internal/` PRDs, gaps, house rules — the agent pushes
# The agent never pushes the base branch: approved docs land on a per-ticket branch
# and reach it only when a human merges.
# DOCS_REPO_URL=git@github.com:you/your-docs-repo.git
# DOCS_REPO_BRANCH=main
# DOCS_REPO_INTERNAL_BRANCH=vault-live

# Deploy key with write access. If it is mounted read-only (Secret Manager mounts at
# 0444) the agent copies it to a private path first, because ssh refuses a key others
# can read — the failure otherwise reads as `Permission denied (publickey)`.
# DOCS_REPO_SSH_KEY=/absolute/path/to/deploy-key

# PR-opening rights (the deploy key can push but cannot open pull requests). Two ways,
# app preferred — without either, the branch is still pushed and mergeable by hand:
#
# (a) A GitHub App — installed on ONLY the docs repo with two permissions (Pull requests:
#     read & write, Contents: read), acting as its own [bot] identity, authenticating
#     with hour-lived tokens minted from this key. Name it for the agent whose act it
#     performs — the PR proposes a doc Scribe authored, so `scriptorium-scribe` reads as
#     "the agent proposes, a human disposes" right on the PR. Create at
#     github.com/settings/apps -> New GitHub App (webhook off), generate a private key,
#     then Install App -> only the docs repo.
# DOCS_REPO_GITHUB_APP_ID=
# DOCS_REPO_GITHUB_APP_KEY=/absolute/path/to/app-private-key.pem   # or the PEM itself
#
# (b) A fine-grained PAT scoped to the docs repo (Pull requests: read & write,
#     Contents: read). Simpler, but it is a person's credential acting as that person.
# DOCS_REPO_TOKEN=

# Working clone. Scratch — re-created from the remote on every boot, so it needs no
# persistence. Keep it on local disk: a GCS FUSE mount has no hardlinks and `git
# clone` into one fails.
# DOCS_REPO_WORKDIR=.scriptorium-state/docs-repo

# Identity the agent commits as — the CHASSIS, not one agent, on purpose: a single push
# carries both agents' work (Scribe's doc, Curator's links and index), so naming it
# "scribe" would misattribute half of it. The human approver is in the commit message.
# Must be an email GitHub can associate with a user,
# or Vercel blocks the build (COMMIT_AUTHOR_REQUIRED) and the doc never reaches the
# site. The noreply form always works: <id>+<login>@users.noreply.github.com
# DOCS_REPO_COMMIT_NAME=scriptorium agent
# DOCS_REPO_COMMIT_EMAIL=

# ============================================================================
# Published sites — where a cited note can actually be read
# ============================================================================
# Optional. Without these a citation still names its note, it just cannot be opened, which
# is the difference between provenance a reader trusts and provenance a reader can check.
# The public site's content root is the vault's `docs/` folder, so `docs/x` is served at
# `/x`; the internal site renders the whole internal tree at matching paths. Notes under
# `reference/` are never on either site — they are retrieved third-party pages, and a
# citation to one goes to the `source_url` it carries.
# EXTERNAL_SITE_URL=https://your-docs-site.example.com
# INTERNAL_SITE_URL=https://your-internal-site.example.com

# ============================================================================
# Webhooks — optional; the poller works without them
# ============================================================================
# Jira's REST webhook API is Connect/OAuth-only (an API token gets 403), so register
# it by hand: Jira Settings -> System -> WebHooks, URL
#   https://<your-host>/jira/webhook/<JIRA_WEBHOOK_SECRET>
# The high-entropy path segment is the first gate, and the only one if no secret is set.
# JIRA_WEBHOOK_SECRET=
# That same form DOES offer a secret. When set, Jira signs the payload on
# `X-Hub-Signature` and the ingress verifies it — strictly better than the path alone.
# JIRA_WEBHOOK_HMAC_SECRET=
# GitHub push events, signed on `X-Hub-Signature-256`. This is how a human edit to a
# published doc gets reported back onto its Jira ticket.
# GITHUB_WEBHOOK_SECRET=

# ============================================================================
# Paths and port (defaults are fine)
# ============================================================================
# PORT=8080
# VAULT_DIR=vault
# AUDIT_FILE=audit/log.jsonl
# The processed-comment ledger. Must persist, or every ticket looks like first sight
# again and the agent re-greets and re-drafts work it already did.
# STATE_DIR=.scriptorium-state

# --- Slack: Teammate (the general governed agent, ADR-001) ---
TEAMMATE_SLACK_BOT_TOKEN=
TEAMMATE_SLACK_APP_TOKEN=
# Channel ids it answers in. Empty: it answers nowhere.
TEAMMATE_SLACK_CHANNELS=
# Slack user ids whose Approve click carries out a write (Jira comment / new issue).
TEAMMATE_APPROVERS=
# Jira projects it may read (default: JIRA_PROJECT_KEY) and Confluence spaces it may read. Empty spaces: no Confluence.
TEAMMATE_JIRA_PROJECTS=
TEAMMATE_CONFLUENCE_SPACES=
# Weekly digest (cited summary of what moved in Jira + new doc gaps). Must be one of TEAMMATE_SLACK_CHANNELS.
# Posted once per ISO week at the first hourly check at/after WEEKDAY (1=Mon..7=Sun) and HOUR, UTC.
TEAMMATE_DIGEST_CHANNEL=
# TEAMMATE_DIGEST_WEEKDAY=1
# TEAMMATE_DIGEST_HOUR=9

# Signs approved lessons and memories (HMAC). With it set, a restore from the docs repo will not trust an
# "approved" note it did not sign. Deployment-only: never commit it. Generate: openssl rand -hex 32
SCRIPTORIUM_SIGNING_KEY=

# Run viewer: every Teammate reply's run id links to /runs/<id>?token=… on the ingress.
# The page shows a run's audit trail (questions, tool calls, approvals) — treat the token as a credential.
# TRACE_TOKEN=
# PUBLIC_BASE_URL=https://your-service.run.app

# Hybrid retrieval: BM25 fused with Gemini embeddings (Vertex; needs VERTEX_PROJECT_ID). Off by default.
# On the golden set it lifts paraphrase recall@5 0.889 -> 1.0 and MRR 0.722 -> 0.944. Vectors cache in STATE_DIR.
# RETRIEVAL_EMBEDDINGS=gemini
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# The Teammate's OWN Atlassian service account. Without it, the Teammate reads Jira/Confluence with the shared
# token above but cannot write (two agents on one token are one identity). Create one under Atlassian Administration.
# TEAMMATE_ATLASSIAN_EMAIL=
# TEAMMATE_ATLASSIAN_TOKEN=

# The Teammate's OWN GitHub App (not the docs repo's) and the repos it may read / comment on (owner/name, comma-separated).
# Minimal permissions: Contents read, Pull requests read+write (comments). Without all three: no GitHub tools.
# TEAMMATE_GITHUB_APP_ID=
# TEAMMATE_GITHUB_APP_KEY=
# TEAMMATE_GITHUB_REPOS=
# Automatic PR checks: PRs opened on TEAMMATE_GITHUB_REPOS (via the GitHub webhook, pull_request events) are checked
# against their Jira ticket; the summary and the approval card for the comment go to this channel.
# TEAMMATE_PR_CHANNEL=
