# Source upload for `gcloud run deploy --source`. Keep it lean and deterministic:
# secrets come from Secret Manager, the vault is restored from the docs repo at boot.
.git
.gitignore
.claude
node_modules
**/node_modules
.scriptorium-state
audit
out
# `vault/reference` is derived and regenerated at boot from `corpus/`, which therefore
# HAS to ship: without it the deployed Curator holds only the notes the agents wrote and
# answers NOT_IN_KB to every question about the product the corpus documents.
vault/reference
samples/wireframes/*.png
.env
*.log
.DS_Store
